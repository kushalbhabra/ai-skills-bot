# ── Option 1: GitHub Models (recommended) ──────────────────────────────────
# Create a token at https://github.com/settings/tokens with Models access.
# Browse available models at https://github.com/marketplace/models
GITHUB_TOKEN=
GITHUB_MODELS_ENDPOINT=https://models.github.ai/inference
GITHUB_MODEL=openai/gpt-4o

# ── Option 2: Azure OpenAI ──────────────────────────────────────────────────
# Also works with any OpenAI-compatible endpoint (e.g. models.github.ai).
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_VERSION=2024-08-01-preview
AZURE_OPENAI_MODEL_DEPLOYMENT_NAME=gpt-4o

# ── Option 3: Anthropic fallback ────────────────────────────────────────────
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5
